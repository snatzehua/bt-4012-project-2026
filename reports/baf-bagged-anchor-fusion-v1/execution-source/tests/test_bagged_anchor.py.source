@pytest.mark.parametrize('kind',['anchor','aggregate','logit','blend'])
def test_partial_derived_cache_fails_without_overwrite(analytical_grid,kind):
    c,fp,frame=analytical_grid
    name=next(n for n in report.graph(report.NAMES)['derived'] if report.independent_spec(n)['kind']==kind)
    rp,pp=run.paths(c,'validation',4,name);before=rp.read_bytes();pp.unlink()
    with pytest.raises(ValueError,match='Partial'):run.derived(c,fp,name,4)
    assert rp.read_bytes()==before and not pp.exists()


@pytest.mark.parametrize('kind',['anchor','aggregate','logit','blend'])
def test_absent_derived_reconstructs_exactly_without_extra_scores(analytical_grid,kind):
    c,fp,frame=analytical_grid
    name=next(n for n in report.graph(report.NAMES)['derived'] if report.independent_spec(n)['kind']==kind)
    rp,pp=run.paths(c,'validation',4,name);values=run.prediction(c,'validation',4,name)['scores']
    rp.unlink();pp.unlink();r=run.derived(c,fp,name,4)
    assert not r['reused'] and np.array_equal(values,run.prediction(c,'validation',4,name)['scores'])


@pytest.mark.parametrize('field',['parameters','source_months'])
def test_current_or_future_policy_sources_rejected(analytical_grid,field):
    c,fp,frame=analytical_grid;p=Path(c['output_dir'])/'crossfit.csv';t=pd.read_csv(p)
    if field=='parameters':
        import json
        r=json.loads(t.loc[0,field]);r['source_months']=[int(t.loc[0,'eval_month'])];t.loc[0,field]=json.dumps(r)
    else:
        t.loc[0,field]='4,5,6,7'
    t.to_csv(p,index=False)
    with pytest.raises(ValueError):report.audit_tables(c,fp,frame)


@pytest.mark.parametrize('name,policy',list(product(report.NAMES,report.POLICIES)))
def test_all_actual_cache_type_bounds(name,policy,tmp_path):
    c=dict(read_config(run.CONFIG),output_dir=str(tmp_path/'own'))
    origin=dict(c,output_dir=str(tmp_path/'origin'));roles=scores.choices_for(name,policy)
    wanted=next(v for v in evidence()['winner_policy_cases'] if v['winner']==name and v['policy']==policy)
    for spec in run.reference_specs(c):
        for p in run.source_paths(origin,spec,7,'exploratory'):
            p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(b'cache-availability-only; not a model audit')
    with patch.object(run,'source_origins',return_value=[(origin,{})]):
        b=run.final_fit_bounds(c,roles)
    assert b['unique_base_results']==len(wanted['dependencies']['bases'])
    assert b['physical_scores']==len(wanted['dependencies']['scores'])
    assert b['max_new_bagged_fits']==wanted['current_new_bagged_fit_bound']
    assert b['max_reproduced_additive_fits']==b['max_reproduced_tree_fits']==0
    with patch.object(run,'source_origins',return_value=[]):
        fresh=run.final_fit_bounds(c,roles)
    assert fresh['max_reproduced_additive_fits']==2 and fresh['max_reproduced_tree_fits']==3
    assert fresh['max_new_bagged_fits']==len(wanted['dependencies']['bagged_bases'])


def miniature_context(tmp_path):
    c=dict(read_config(run.CONFIG),output_dir=str(tmp_path/'own'))
    source=dict(read_config(run.parent.CONFIG),report_dir=str(tmp_path/'source-report'))
    sp=tmp_path/'source.json';write_json(sp,source);c['parent_config']=str(sp)
    r=copy.deepcopy(read_config('reports/baf-bagged-lightgbm-seeds-v1/miniature_gate.json'))
    mapping={p:str(tmp_path/'optional'/Path(p).name) for p in r['files']}
    r['files']={mapping[p]:h for p,h in r['files'].items()}
    for item in r['results']:
        item['files']={mapping[p]:h for p,h in item['files'].items()}
    write_json(Path(source['report_dir'])/'miniature_gate.json',r)
    return c,r


def fake_older_gate(c,fp):
    write_json(Path(c['output_dir'])/'source_miniature_gate.json',dict(fingerprint=fp,preserved_fits=8,
        optional_source_artifacts_present=0,new_production_miniature_fits=0))


def test_preserved_nine_fit_gate_allows_wholly_absent_optional_models_without_fitting(tmp_path):
    c,r=miniature_context(tmp_path)
    with patch.object(run.parent.previous,'source_miniature_gate',side_effect=fake_older_gate), \
         patch('lightgbm.LGBMClassifier.fit',side_effect=AssertionError('No new miniature fits')):
        result=run.source_miniature_gate(c,{'fixture':True})
    assert result['preserved_sampling_fits']==9 and result['preserved_older_fits']==8
    assert result['optional_sampling_artifacts_present']==result['new_production_miniature_fits']==0


@pytest.mark.parametrize('bad',['partial','corrupt','fit_count','repeat','spec','fingerprint'])
def test_sampling_gate_corruption_is_retained_without_retry(tmp_path,bad):
    c,r=miniature_context(tmp_path);source=read_config(c['parent_config']);p=Path(source['report_dir'])/'miniature_gate.json'
    if bad in ['partial','corrupt']:
        for q in list(r['files'])[:1 if bad=='partial' else len(r['files'])]:
            q=Path(q);q.parent.mkdir(parents=True,exist_ok=True);q.write_bytes(b'corrupt')
    elif bad=='fit_count':r['fit_count']=8
    elif bad=='repeat':r['same_seed_repeatable']=False
    elif bad=='spec':r['results'][0]['spec']['fraction']=.7
    else:r['fingerprint']={'corrupt':True}
    write_json(p,r)
    with patch.object(run.parent.previous,'source_miniature_gate',side_effect=AssertionError('Invalid source must fail first')):
        with pytest.raises(ValueError):run.source_miniature_gate(c,{})
    assert (Path(c['output_dir'])/'failures/source-miniature.json').is_file()
    with pytest.raises(ValueError,match='Prior source-miniature'):run.source_miniature_gate(c,{})


def test_work_accounting_separates_original_reuse_from_this_invocation(analytical_grid):
    c,fp,frame=analytical_grid
    records=[]
    for name in report.graph(report.NAMES)['bases']:
        records.append(dict(candidate=name,reused=True))
    ds=[{'reused':i<7} for i in range(29)]
    result=run.work_accounting(c,records,ds,[{'work':'audit existing'}])
    assert result['base_results']==11 and result['bagged_reuses']==6 and result['reference_reuses']==5
    assert result['new_bagged_fits']==result['reproduced_additive_fits']==result['reproduced_tree_fits']==0
    assert result['derived_reuses']==7 and result['new_derived_computations']==22


def test_plot_all_operating_points_and_canonical_curve_values(analytical_grid,tmp_path):
    c,fp,frame=analytical_grid;summary=pd.read_csv(Path(c['output_dir'])/'summary.csv')
    report.operating_figure(summary,tmp_path);report.audit_figure(summary,tmp_path)
    assert len(pd.read_csv(tmp_path/'plotted_operating_points.csv'))==111
    assert len(pd.read_csv(tmp_path/'plotted_alpha_curves.csv'))==60
    curve=tmp_path/'plotted_alpha_curves.csv';t=pd.read_csv(curve);t.loc[0,'candidate']='duplicate_endpoint';t.to_csv(curve,index=False)
    with pytest.raises(ValueError):report.audit_figure(summary,tmp_path)


@pytest.mark.parametrize('winner',[
    report.H,'logit_baseline_lgbm','bagged_balanced_s17','bagged_unweighted_logit_mean',
    'bagged_anchor_unweighted_prob_a25'])
def test_conditional_uncertainty_all_role_classes_and_aliases(analytical_grid,winner):
    c,fp,frame=analytical_grid;c=dict(c,bootstrap_replicates=7)
    roles=scores.choices_for(winner,'latest');s={'choices':roles};h=run.history(c)
    cf=pd.read_csv(Path(c['output_dir'])/'crossfit.csv')
    data={a:h[n][6] for a,(n,k) in roles.items()}
    masks={a:report.independent_mask(data[a],report.independent_rule(h[n],k,6)) for a,(n,k) in roles.items()}
    dint,dd,fint,fd=report.uncertainty(c,s,cf,h,data,masks)
    assert len(dint)==3*(len(roles)-1) and len(fint)==len(roles)-1
    assert len(dd)==14 and len(fd)==7
    for a in set(roles)-{'selected'}:
        if roles[a]==roles['selected']:
            assert (dd[a]==0).all() and (fd[a]==0).all()


@pytest.mark.parametrize('bad',['none','unaudited','wrong_winner','wrong_policy','changed_table',
                               'changed_roles','changed_rule','changed_bounds','changed_source'])
def test_freeze_and_load_reject_stale_or_unaudited_lifecycle(analytical_grid,monkeypatch,bad):
    # Analytical orchestration fixture only: real source audits run on the actual data.
    c,fp,frame=analytical_grid;out=Path(c['output_dir'])
    monkeypatch.setattr(run,'initialize',lambda path:(c,fp))
    monkeypatch.setattr(run,'execution_gate',lambda *args:None)
    monkeypatch.setattr(run,'final_fit_bounds',lambda *args:{'fixture':'cache-bound unit orchestration'})
    done=dict(fingerprint=fp,files={n:digest(out/n) for n in run.TABLES})
    write_json(out/'validation_complete.json',done)
    w=pd.read_csv(out/'summary.csv').iloc[0]
    audit=dict(fingerprint=fp,validation_sha256=digest(out/'validation_complete.json'),
               actual_source_models_audited=True,saved_model_checks=33,
               winner=str(w.candidate),policy=str(w.policy),development_f2=float(w.f2),
               fixture='synthetic orchestration; no real source-model audit claim')
    if bad=='unaudited':audit['actual_source_models_audited']=False
    elif bad=='wrong_winner':audit['winner']='undeclared'
    elif bad=='wrong_policy':audit['policy']='undeclared'
    write_json(out/'independent_development_audit.json',audit)
    if bad=='changed_table':
        with (out/'summary.csv').open('a') as f:f.write('\n')
    if bad in ['unaudited','wrong_winner','wrong_policy','changed_table']:
        with pytest.raises(ValueError):run.freeze('fixture')
        assert not (out/'selection.json').exists()
        return
    selected=run.freeze('fixture')
    assert run.load_selection('fixture')[1]==selected
    with pytest.raises(ValueError,match='immutable'):run.freeze('fixture')
    if bad=='none':return
    if bad=='changed_roles':selected['choices']['selected']=[report.H,'pooled']
    elif bad=='changed_rule':selected['rules']['selected']={'hindsight':True}
    elif bad=='changed_bounds':selected['final_fit_bounds']={'corrupt':True}
    elif bad=='changed_source':
        p=next((out/'runs').glob('*.json'));p.write_text('{}')
    write_json(out/'selection.json',selected)
    with pytest.raises(ValueError):run.load_selection('fixture')
