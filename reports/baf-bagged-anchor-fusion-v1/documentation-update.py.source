old='Codex assisted with the separate bagged-anchor declaration,';start=text.index(old);end=text.index('\n\n',start)
text=text[:start]+'''Codex assisted with the separate bagged-anchor declaration, isolated implementation, individual source/cache audits, fixed arithmetic, chronological F2 selection, bounded exploratory transfer, conditional uncertainty, figure checks and reproducible execution. The code uses preserved NumPy/SciPy/pandas/scikit-learn/LightGBM/XGBoost/joblib APIs and copies no public notebook. The failed five-reference comparison and consumed-holdout limitations are retained.''' +text[end:];text=text.replace('.venv/bin/python -m baf.bagged_anchor_report audit_development\n','').replace('the explicit audit command repeats that verification before freeze.','the standalone `audit_development` entry point is also available.')
p.write_text(text)
