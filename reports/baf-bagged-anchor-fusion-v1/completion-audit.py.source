from pathlib import Path
import re,shutil,xml.etree.ElementTree as ET
from baf.common import read_config,write_json,digest
from baf import bagged_anchor_study as run
c=read_config(run.CONFIG);o=Path(c['output_dir']);d=Path(c['report_dir']);change=Path('openspec/changes/test-bagged-anchor-fusion-f2')
run.guard(c);a=read_config(d/'audit.json');e=read_config(d/'execution_verification.json');f=read_config(d/'figure_verification.json');r=read_config(d/'reproduction_verification.json')
assert a['saved_development_models_checked']==33 and a['saved_final_models_checked']==11
assert a['direct_draws_checked']==1500 and a['development_intervals']==75 and a['consumed_intervals']==25
assert e['new_development_fits']==0 and e['new_final_bagged_fits']==6
assert f['visually_inspected'] and f['pixel_identical_regeneration'] and r['full_suite_passed']==1501
assert not a['measured_gain_on_both_scopes']
run.verify_hashes(read_config(d/'generated_report_hashes.json'))
ledger=read_config(d/'test_model_fits.json');run.verify_hashes(ledger['execution_source_sha256']);assert ledger['exit_code']==0 and ledger['junit_sha256']==digest(d/'tests.xml')
cases=list(ET.parse(d/'tests.xml').getroot().iter('testcase'));assert len(cases)==1501
assert sum(t.get('classname','').endswith('test_bagged_anchor') for t in cases)==431
# Evidence coverage is tied to named real-data/negative fixtures, not counts alone.
requirements=[
 ('Prospective isolated preserved study',['declaration_verification.json','source_cache_inventory.json','preparation_verification.json','reproduction_verification.json','tests.xml'],'Exact recipes and frozen identities; six genuine absent-cache fits with audited reuse/partial rejection; actual33-model source preparation and16 ancestor restores.'),
 ('Fixed domain-correct label-free addition',['independent_development_audit.json','expressions.csv','run_provenance.json','tests.xml'],'Full actual120-score association/provenance audit plus domain,nonfinite,member,row/label and unrelated-row corruption fixtures.'),
 ('Canonical controls and visible aliases',['selection.json','freeze_verification.json','figure_verification.json','consumed_intervals.csv','tests.xml'],'111 prospective role cases,actual26 visible roles sharing27-score dependencies,canonical endpoints and zero-difference aliases.'),
 ('Comparable chronological actual-F2 selection',['crossfit.csv','summary.csv','independent_development_audit.json','selection.json','run_provenance.json'],'All222 actual earlier-only operating rules/masks/metrics and deterministic macro winner independently reconstructed on identical populations.'),
 ('Complete matched ensemble and addition effects',['contrasts.csv','matched_effect_summary.csv','diversity.csv','decision_overlap.csv','clipping.csv','expressions.csv','independent_development_audit.json'],'Every947 exact factor and numerical effect plus18 diversity,36 overlap,39 clipping and60 expression rows; ties and negatives retained.'),
 ('Frozen bounded transfer and honest acceptance',['selection.json','freeze_verification.json','exploratory_access.json','transfer_complete.json','transfer_provenance.json','audit.json','findings.md'],'Frozen26 roles/11 bases/27 scores and tighter6/0/0 fit bounds precede access; independent saved-inference/exact-artifact/rule/metric audit. Two required consumed comparisons fail; objective remains active.'),
 ('Independently verified reproducible completion',['execution_verification.json','figure_verification.json','reproduction_verification.json','documentation_verification.json','execution-history.md','tests.xml','audit.json'],'Direct reconstruction of1500 paired draws and100 intervals; inspected/pixel-identical figure,closed logs,exact source/JUnit/fit receipt,pins/data/restores,clean no-prior-cache suite and explicit uncertainty exclusions.')]
spec=next((change/'specs').glob('*/spec.md')).read_text()
assert re.findall(r'^### Requirement: (.+)$',spec,re.M)==[n for n,paths,reason in requirements]
def proof(paths):
 for p in paths:assert (d/p).is_file(),p
 return {str(d/p):digest(d/p) for p in paths}
reqs=[dict(requirement=n,status='verified',evidence=proof(paths),scope=reason) for n,paths,reason in requirements]
scenario_proof={
 'Encounter an incomplete required cache':(['tests.xml'],'Real tiny source-format fixture partial/corrupt cases reject in place without refit/fallback.'),
 'Reproduce a wholly absent required source':(['tests.xml','reproduction_verification.json'],'Six genuinely fitted exact tiny formats,then audited-cache no-fit reuse; no prior-cache clean copy.'),
 'Add an ensemble to an unbounded anchor':(['tests.xml','independent_development_audit.json'],'Margins outside0..1 retained; actual source/composition domain audit.'),
 'Change current labels or unrelated applications':(['tests.xml'],'Per-strategy row/label mutation invariance and singleton composition fixtures.'),
 'Display a unit-weight endpoint':(['figure_verification.json','plotted_alpha_curves.csv'],'Canonical original G control identities and endpoint values; no extra evaluated strategies.'),
 'Decide for month 6':(['crossfit.csv','independent_development_audit.json'],'Actual train0..5 and earlier4/5-or-latest5 rules independently rebuilt.'),
 'Attribute a blend gain':(['contrasts.csv','matched_effect_summary.csv'],'All fixed anchor/member/seed/weight/form/weighting/control factors retained,including negative/tied effects.'),
 'Transfer a blend winner':(['freeze_verification.json','selection.json','exploratory_access.json','transfer_complete.json','audit.json'],'Actual blend winner26 roles,exact11-base/27-score DAG frozen before bounded access;6 new bagged fits,5 reference reuses.'),
 'Fail a required reference comparison':(['audit.json','findings.md'],'Actual failures versus tree fusion and unweighted recorded; objective remains active.'),
 'Fail an exact required source gate':(['tests.xml','verification-attempts.json','execution-history.md'],'Retained failure/no-retry fixtures; full scientific run had no failed source gate. Supplementary maximum-versus-actual assertion is retained separately and changed no science.'),
 'Complete a negative finite experiment':(['audit.json','findings.md','execution_verification.json'],'Scientific output complete and criterion false; completion of finite work does not mark broader objective achieved.')}
scenarios=re.findall(r'^#### Scenario: (.+)$',spec,re.M);assert set(scenarios)==set(scenario_proof)
sc=[dict(scenario=n,status='verified',evidence=proof(scenario_proof[n][0]),scope=scenario_proof[n][1]) for n in scenarios]
task_proof={
 '1.1':['declaration_verification.json'], '1.2':['preparation_verification.json','tests.xml'],
 '2.1':['expressions.csv','independent_development_audit.json','tests.xml'],
 '2.2':['independent_development_audit.json','tests.xml'], '2.3':['test_model_fits.json','tests.xml','methodological-invocations.json'],
 '3.1':['resource_preflight.json','source_miniature_gate.json','execution_gates_verification.json'],
 '3.2':['preparation_verification.json','run_provenance.json'], '3.3':['independent_development_audit.json'],
 '4.1':['selection.json','freeze_verification.json','tests.xml'], '4.2':['audit.json','transfer_provenance.json','execution_verification.json'],
 '5.1':['audit.json','development_draws.csv','consumed_draws.csv','development_intervals.csv','consumed_intervals.csv'],
 '5.2':['findings.md','matched_effect_summary.csv','figure_verification.json'],
 '5.3':['reproduction_verification.json','documentation_verification.json','replay_setup.json','execution-history.md'],
 '5.4':['execution_verification.json','prearchive-openspec-validation.log']}
actual_tasks=re.findall(r'^- \[[ x]\] (\d+\.\d+) ',(change/'tasks.md').read_text(),re.M);assert set(actual_tasks)==set(task_proof)
write_json(d/'completion-requirements.json',dict(requirements=reqs,scenarios=sc,tasks=[dict(task=n,status='verified',evidence=proof(task_proof[n])) for n in actual_tasks],requirements_verified=len(reqs),scenarios_verified=len(sc),tasks_verified=len(actual_tasks),broader_goal_achieved=False))
shutil.copyfile(o/'preservation.json',d/'preservation.json')
write_json(d/'run_hashes.json',{str(p):digest(p) for p in sorted(o.rglob('*')) if p.is_file()})
write_json(d/'compile_verification.json',dict(command='.venv/bin/python -m compileall -q baf tests scripts/check_bagged_anchor.py',exit_code=0,execution_sources_unchanged=True))
p=change/'tasks.md';t=p.read_text().replace('- [ ] 5.4 ','- [x] 5.4 ');t=t.replace('13/14 tasks verified; final closure5.4 remains.','14/14 tasks verified; requirements/scenarios/tasks,closed logs,preservation,source identities,figures,pins/data/reproduction,compile and strict validation passed. Synchronization/archive follows.')
p.write_text(t)
print('Verified',len(reqs),'requirements,',len(sc),'scenarios and',len(actual_tasks),'tasks; broad goal still false.')
